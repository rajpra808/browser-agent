{
  "name": "@rajpra808/browser-agent",
  "version": "1.0.0",
  "description": "Vision-based browser automation CLI — LLM sees screenshot, clicks coordinates, no selectors. Supports Claude, Gemini, OpenAI, Ollama.",
  "main": "dist/cli.js",
  "bin": {
    "browser-agent": "dist/cli.js"
  },
  "files": [
    "dist/",
    "browser-agent.config.example.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "browser-automation",
    "llm",
    "playwright",
    "claude",
    "gemini",
    "openai",
    "ollama",
    "vision",
    "ai-agent",
    "cli"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsc 2>/dev/null || true",
    "prepublishOnly": "npm test",
    "postinstall": "node dist/postinstall.js"
  },
  "dependencies": {
    "playwright": "latest",
    "commander": "latest",
    "dotenv": "latest",
    "zod": "latest",
    "typescript": "latest",
    "@types/node": "latest"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "latest",
    "@google/genai": "latest",
    "openai": "latest"
  },
  "devDependencies": {
    "tsx": "latest",
    "vitest": "^2.1.0"
  }
}
